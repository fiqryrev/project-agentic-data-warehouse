# Copy to .env (gitignored); `make up-core` creates it and fills empty secrets.
# Shared by the Airflow api-server and scheduler to sign task tokens. Any random string.
AIRFLOW_JWT_SECRET=
# Password of the Airflow metadata database (Postgres). Any random string; hex keeps the URL valid.
AIRFLOW_DB_SECRET=
# First day the warehouse_daily DAG schedules (catchup starts here when it is unpaused).
WAREHOUSE_START_DATE=2026-01-01

# --- obs profile (M8). Provider keys: the only place they live. ---
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Generated by `make up-obs` when empty (random hex).
OBS_DB_SECRET=
LITELLM_MASTER_SECRET=
LANGFUSE_SALT_SECRET=
LANGFUSE_ENCRYPTION_SECRET=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_PROJECT_PUBLIC_SECRET=
LANGFUSE_PROJECT_SECRET=
LANGFUSE_ADMIN_SECRET=
CLICKHOUSE_SECRET=
MINIO_SECRET=
REDIS_SECRET=
# Virtual keys per caller, written by infra/llm-gateway/bootstrap.py (budgets.yaml).
GATEWAY_KEY_AUTO_ONTOLOGY=
GATEWAY_KEY_GOLDEN_RUNNER=
GATEWAY_KEY_AGENT_DEV=

# --- ontology profile (M9). Generated by `make up-ontology` when empty. ---
AO_DB_SECRET=
AO_ADMIN_SECRET=
AO_AUTH_SECRET=
# Auto Ontology's chat aliases; leave empty for the defaults (openai/adw-reasoning and
# openai/adw-non-reasoning). make compare-providers sets them for one run only (M12).
AO_REASONING_MODEL=
AO_NON_REASONING_MODEL=
