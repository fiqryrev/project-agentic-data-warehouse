# Copy to .env (gitignored); `make up-core` creates it and fills empty secrets.
# Shared by the Airflow api-server and scheduler to sign task tokens. Any random string.
AIRFLOW_JWT_SECRET=
# Password of the Airflow metadata database (Postgres). Any random string; hex keeps the URL valid.
AIRFLOW_DB_SECRET=
# First day the warehouse_daily DAG schedules (catchup starts here when it is unpaused).
WAREHOUSE_START_DATE=2026-01-01
