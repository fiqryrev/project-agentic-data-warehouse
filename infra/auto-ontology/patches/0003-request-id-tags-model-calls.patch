diff --git a/auto_ontology/utils/request_tags.py b/auto_ontology/utils/request_tags.py
new file mode 100644
index 00000000..87af3ed3
--- /dev/null
+++ b/auto_ontology/utils/request_tags.py
@@ -0,0 +1,45 @@
+"""The request id of the question a chat worker is answering, sent with every model call.
+
+A caller (an evaluation harness) may pass ``request_id`` with a chat question. The worker sets it
+here for the duration of that question, and every model client adds
+``x-litellm-tags: answer:<request_id>`` to its requests, so a LiteLLM gateway records which
+question each call served. A worker subprocess answers one question at a time, and model calls
+may run on helper threads, so this is a module value rather than a context variable.
+"""
+
+from __future__ import annotations
+
+import re
+
+_REQUEST_ID: str | None = None
+_SAFE = re.compile(r"^[A-Za-z0-9._:-]{1,128}$")
+
+
+def set_request_id(request_id: str | None) -> None:
+    """Set (or clear, with None) the request id of the question being answered."""
+    global _REQUEST_ID
+    _REQUEST_ID = request_id if request_id and _SAFE.match(request_id) else None
+
+
+def tag_headers() -> dict[str, str]:
+    """Headers that tag a model call with the current request id; empty without one."""
+    return {"x-litellm-tags": f"answer:{_REQUEST_ID}"} if _REQUEST_ID else {}
+
+
+def _tag_request(request) -> None:  # noqa: ANN001 (httpx.Request)
+    for name, value in tag_headers().items():
+        request.headers[name] = value
+
+
+async def _tag_request_async(request) -> None:  # noqa: ANN001 (httpx.Request)
+    _tag_request(request)
+
+
+def tagging_http_clients(timeout: float | None):  # noqa: ANN201
+    """(sync, async) httpx clients that add the tag headers to every request they send."""
+    import httpx
+
+    return (
+        httpx.Client(timeout=timeout, event_hooks={"request": [_tag_request]}),
+        httpx.AsyncClient(timeout=timeout, event_hooks={"request": [_tag_request_async]}),
+    )
